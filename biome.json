{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/src/**/*",
            "**/.vscode/**/*",
            "**/index.html",
            "**/vite.config.ts",
            "!**/src/routeTree.gen.ts",
            "!**/src/styles.css",
            "!**/public/**/*"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            ["react", "react-dom", "react-dom/**"],
                            ":BLANK_LINE:",
                            [":NODE:"],
                            ":BLANK_LINE:",
                            ["@tanstack/**"],
                            ":BLANK_LINE:",
                            [":PACKAGE:"],
                            ":BLANK_LINE:",
                            ["@/types/**"],
                            ":BLANK_LINE:",
                            ["@/integrations", "@/integrations/**"],
                            ":BLANK_LINE:",
                            ["@/lib/**", "@/hooks/**"],
                            ":BLANK_LINE:",
                            ["@/schemas/**", "@/schemas"],
                            ":BLANK_LINE:",
                            ["@/services/**", "@/services"],
                            ":BLANK_LINE:",
                            ["@/clients/**", "@/clients"],
                            ":BLANK_LINE:",
                            ["@/actions/**", "@/actions"],
                            ":BLANK_LINE:",
                            ["@/components/**"],
                            ":BLANK_LINE:",
                            [":PATH:", "./**", "../**"]
                        ]
                    }
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noSvgWithoutTitle": "off",
                "useSemanticElements": "off",
                "noStaticElementInteractions": "off",
                "useKeyWithClickEvents": "off",
                "noLabelWithoutControl": "off"
            },
            "correctness": {
                "noUnusedImports": "error",
                "useUniqueElementIds": "off",
                "noChildrenProp": "off",
                "noNestedComponentDefinitions": "off",
                "useExhaustiveDependencies": "off",
                "noComponentHookFactories": "off",
                "noUnusedVariables": "off"
            },
            "suspicious": {
                "noArrayIndexKey": "off",
                "noExplicitAny": "off"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            },
            "complexity": {
                "useOptionalChain": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "jsxQuoteStyle": "single"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    }
}
